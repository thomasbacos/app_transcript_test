# Copy to .env for local runs (docker compose / uvicorn). In production, set these in your host's dashboard.

# --- Required ------------------------------------------------------------------------------------
# Your OpenAI key. It stays on the server: the iPhone app never sees it.
OPENAI_API_KEY=sk-...
# Long random string that signs session tokens (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me

# --- App Store -----------------------------------------------------------------------------------
# Must match the app's bundle id (ios/Config/Parley.xcconfig -> PARLEY_BUNDLE_ID)
APP_BUNDLE_ID=com.thomasbacos.parley
# Numeric "Apple ID" of the app (App Store Connect -> App Information). Needed to verify real purchases.
APPLE_APP_ID=
# Which purchase environments are accepted. Production,Sandbox for TestFlight + App Store (+ App Review).
# Add Xcode ONLY on a development server, to test with ios/Config/Products.storekit in the simulator.
APPLE_ENVIRONMENTS=Production,Sandbox

# --- Plans (minutes of audio). Change any time, no app update needed -----------------------------
PLAN_TRIAL_MINUTES=60
PLAN_TRIAL_MAX_FILE_MINUTES=60
PLAN_ESSENTIAL_MINUTES=240
PLAN_ESSENTIAL_MAX_FILE_MINUTES=120
PLAN_PRO_MINUTES=600
PLAN_PRO_MAX_FILE_MINUTES=240

# --- Storage -------------------------------------------------------------------------------------
# Default: SQLite + files in DATA_DIR (mount a persistent volume there). Postgres also works.
DATA_DIR=./data
# DATABASE_URL=postgresql://user:pass@host:5432/parley

# --- Models (defaults mirror the desktop app) ----------------------------------------------------
TRANSCRIBE_MODEL=gpt-transcribe
DIARIZE_MODEL=gpt-4o-transcribe-diarize
LLM_MODEL=gpt-6-sol
LLM_FALLBACK_MODEL=gpt-6-astra

# --- Capacity & abuse limits ---------------------------------------------------------------------
WORKERS=3                 # recordings processed at the same time
DIARIZE_PARALLEL=8        # speaker chunks in parallel per recording
MAX_UPLOAD_MB=400
MAX_ACTIVE_JOBS=2         # per subscriber
JOBS_PER_DAY=30           # per subscriber

# --- Push notifications ("your transcript is ready"), optional -----------------------------------
# Apple Developer -> Certificates, IDs & Profiles -> Keys -> + -> Apple Push Notifications service
APNS_KEY_ID=
APNS_TEAM_ID=
# Content of the .p8 file; line breaks can be written as \n
APNS_PRIVATE_KEY=

# --- Public pages (privacy policy, terms, support) -----------------------------------------------
OPERATOR_NAME=Thomas Bacos
CONTACT_EMAIL=support@example.com

# GET /admin/stats with header X-Admin-Token: subscribers, hours transcribed, estimated OpenAI cost
ADMIN_TOKEN=
